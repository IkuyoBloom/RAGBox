# ============================================================
#  本地 RAG 系统 - 环境配置模板
#  复制为 .env 后按需修改。所有项都有代码内默认值，不填也能跑。
#  运行时可覆盖的项见 backend/app/core/settings_service.py
# ============================================================

# ---------- 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
# 前端开发服务器地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- LLM 通道 ----------
# ollama = 纯本地 | openai = 任意 OpenAI 兼容接口（云端或本地 vLLM/LM Studio）
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct

# 端口冲突排查：若 Ollama 启动报
#   "bind: An attempt was made to access a socket in a way forbidden by its access permissions"
# 多半是 Windows 的 Hyper-V / WSL2 动态预留了该端口（netstat 会显示无人占用）。
# 查看保留区间：netsh int ipv4 show excludedportrange protocol=tcp
# 换端口：setx OLLAMA_HOST "0.0.0.0:21434"，并同步改上面这行
# 还原默认：以管理员执行 net stop winnat && net start winnat

# 云端通道示例（DeepSeek / 通义 / OpenAI / 本地 vLLM 均可）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# ---------- Embedding ----------
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=bge-m3
EMBED_BATCH_SIZE=16
# 留空表示自动探测（首次调用后缓存）
EMBED_DIM=

# ---------- 文档切分 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- 检索 ----------
ENABLE_HYBRID=true
DENSE_TOP_K=20
SPARSE_TOP_K=20
FINAL_TOP_K=6
# RRF 平滑常数，论文常用 60
RRF_K=60

# ---------- 生成 ----------
ENABLE_QUERY_REWRITE=true
TEMPERATURE=0.2
MAX_TOKENS=1024
# Ollama 上下文窗口
NUM_CTX=8192
